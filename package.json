{
  "name": "blocopy",
  "version": "0.0.0",
  "private": true,
  "description": "Double-click to select and copy a whole block of text. Click a paragraph to leave it out.",
  "type": "module",
  "author": "Lamanitoure",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "vite build --outDir dist-pages",
    "build:web": "vite build --outDir dist-pages",
    "dev": "vite --host 0.0.0.0 --port 3000",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:size": "node scripts/check-size.mjs",
    "lint:ext": "web-ext lint --source-dir dist",
    "translate": "node scripts/translate-locales.mjs",
    "package": "web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:i18n && npm run build && npm run check:size && npm run lint:ext"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.20.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
